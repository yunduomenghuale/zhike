# 智课系统 V2 后端镜像（Django 5 + DRF + gunicorn）
# trixie（Debian 13）自带 LibreOffice 25.x，PPTX 排版保真度显著好于 bookworm 的 7.4
FROM python:3.12-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# 国内 apt 源；安装 LibreOffice（PPT 转 PDF）与全套中文开源字体
# （PDF 出图已改为 pypdfium2 纯 pip 依赖，不再需要 poppler-utils）
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       libreoffice-impress \
       fonts-noto-cjk fonts-wqy-microhei fonts-wqy-zenhei \
       fonts-arphic-uming fonts-arphic-ukai \
    && rm -rf /var/lib/apt/lists/*

# 国内镜像加速安装依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn \
    -i https://pypi.tuna.tsinghua.edu.cn/simple

COPY . .
RUN sed -i 's/\r$//' /app/deploy-entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["sh", "/app/deploy-entrypoint.sh"]
