# 智课系统 V2 后端镜像（Django 5 + DRF + gunicorn）
# trixie（Debian 13）自带 LibreOffice 25.x，PPTX 排版保真度显著好于 bookworm 的 7.4
FROM python:3.12-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# 国内 apt 源；安装 LibreOffice（PPT/Word 转 PDF/docx）与全套中文开源字体
# （PDF 出图已改为 pypdfium2 纯 pip 依赖，不再需要 poppler-utils）
# writer：知识库旧版 .doc 转 docx 解析用；impress：PPT 渲染用
# default-libmysqlclient-dev / pkg-config / build-essential：编译 mysqlclient 驱动用，
# 装完即卸（见下方 pip 层），运行期只留 libmariadb3
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       libreoffice-impress libreoffice-writer \
       fonts-noto-cjk fonts-wqy-microhei fonts-wqy-zenhei \
       fonts-arphic-uming fonts-arphic-ukai \
       default-libmysqlclient-dev build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 国内镜像加速安装依赖
# torch 必须先于 requirements 安装 CPU 版（PyPI 的 Linux torch 是数 GB 的 CUDA 版；
# 先装好 CPU 版后，sentence-transformers 对 torch 的依赖即被满足，不会重复拉取）
COPY requirements.txt .
# mysqlclient 编译完成后卸掉工具链（不加 --auto-remove，避免连 libmariadb3 一起删掉）
# --default-timeout=1000：服务器出网带宽有限，大包（torch 209MB）慢速下载时
# pip 默认 15s 超时会反复 ReadTimeout 中断构建（生产实测踩坑）
RUN pip install --no-cache-dir --default-timeout=1000 torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir --default-timeout=1000 -r requirements.txt gunicorn \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    && apt-get purge -y build-essential pkg-config default-libmysqlclient-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 系统内置本地模型预下载（BGE-M3 + Qwen3-Reranker-0.6B，合计约 3.5GB）：
# 默认开启——「部署时自动下载」；该层在 COPY 源码之前，改代码重建镜像时命中缓存不重复下载。
# 预置目录 /app/models 不是挂载点；容器启动时 entrypoint 把缺失模型拷入数据卷 /app/data/models。
# 裁剪镜像可 docker compose build --build-arg PRELOAD_MODELS=false backend，
# 运行时首次使用会惰性下载，或容器内 manage.py download_models 预热。
ARG PRELOAD_MODELS=true
RUN if [ "$PRELOAD_MODELS" = "true" ]; then \
      python -c "from modelscope import snapshot_download as d; \
d('BAAI/bge-m3', local_dir='/app/models/BAAI/bge-m3'); \
d('Qwen/Qwen3-Reranker-0.6B', local_dir='/app/models/Qwen/Qwen3-Reranker-0.6B')"; \
    fi

COPY . .
RUN sed -i 's/\r$//' /app/deploy-entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["sh", "/app/deploy-entrypoint.sh"]
