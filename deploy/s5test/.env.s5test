# 智课系统 V2 · 124 测试环境（zhike_s5test）后端环境变量
# 注意：SECRET_KEY 不在本文件——124 上组装时从旧部署 .env.production 继承（见部署步骤），
# 避免把密钥提交进仓库。

# —— Django ——
DJANGO_DEBUG=False
# testserver：P1 校验脚本用 DRF APIClient（Host=testserver），不加会被 DisallowedHost 400
DJANGO_ALLOWED_HOSTS=124.70.107.64,localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://124.70.107.64:8088
# 测试环境无 TLS（http 直连）：关闭强制跳转与 HSTS。
# HSTS 按 host（不含端口）记忆，不关会把同 IP 的老站 8088 浏览器访问也强制升到 https。
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# —— 数据库（compose 内 mysql80，独立库 zk_s5test）——
DATABASE_URL=mysql://s5test:S5test2026@mysql80:3306/zk_s5test

# —— 向量检索：124 未装 qdrant-client，走 json 后端（本地模型 + MySQL 存取）——
RAG_VECTOR_BACKEND=json

# —— 本地模型（只读挂载 124 现有 /data/zhike-v2/data/models → /app/data/models）——
AI_MODELS_DIR=/app/data/models

# —— 静态页资源（与生产 bind mount 同构）——
LABS_ROOT=/app/labs
RESOURCES_ROOT=/app/resources

# —— AI 并发：测试环境收敛（不含 worker，队列任务不会被执行，仅排 pending）——
AI_USER_RUNNING_CAP=3
AI_RENDER_CONCURRENCY=2
