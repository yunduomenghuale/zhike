# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS（前端开发地址）
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5273,http://localhost:5273

# 数据库（起步 SQLite；迁移 Postgres 时改为 postgres://user:pass@host:5432/dbname）
DATABASE_URL=sqlite

# ===== 大模型 =====
# 可选值：mock / zhipu / tongyi / baidu
AI_PROVIDER=mock

# 智谱 GLM
ZHIPU_API_KEY=
ZHIPU_CHAT_MODEL=glm-4-flash
ZHIPU_EMBED_MODEL=embedding-3

# 通义千问（阿里 DashScope）
TONGYI_API_KEY=
TONGYI_CHAT_MODEL=qwen3.7-plus
TONGYI_EMBED_MODEL=text-embedding-v3
TONGYI_TTS_MODEL=cosyvoice-v1

# 百度文心
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ===== RAGAS 评估裁判模型：Kimi（Moonshot，OpenAI 兼容，manage.py eval_rag 使用）=====
# 开放平台 key 用 https://api.moonshot.cn/v1；Kimi for Coding 订阅 key（sk-kimi- 开头）
# 用 https://api.kimi.com/coding/v1，模型填 k3
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
