# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS（前端开发地址）
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5273,http://localhost:5273

# 数据库（起步 SQLite；迁移 Postgres 时改为 postgres://user:pass@host:5432/dbname）
DATABASE_URL=sqlite

# ===== 大模型 =====
# 可选值：mock / deepseek / tongyi / openai
AI_PROVIDER=mock

# 通义千问（阿里 DashScope）
TONGYI_API_KEY=
TONGYI_CHAT_MODEL=qwen3.7-plus
TONGYI_EMBED_MODEL=text-embedding-v3
TONGYI_TTS_MODEL=qwen3-tts-flash

# 按能力覆盖（可选，留空则回退上面的全局配置）：
# AI_CHAT_PROVIDER / AI_CHAT_API_KEY / AI_CHAT_BASE_URL / AI_CHAT_MODEL
# AI_EMBED_PROVIDER / AI_EMBED_API_KEY / AI_EMBED_BASE_URL / AI_EMBED_MODEL
# AI_RERANK_PROVIDER / AI_RERANK_API_KEY / AI_RERANK_BASE_URL / AI_RERANK_MODEL
# AI_TTS_PROVIDER / AI_TTS_API_KEY / AI_TTS_BASE_URL / AI_TTS_MODEL

# 检索编排（向量召回 -> 重排序 -> 阈值过滤；不配重排则回退纯向量 top_k）：
# AI_RERANK_RECALL=15（重排前召回候选数）
# AI_RERANK_THRESHOLD=0.3（重排相关性分低于该值判定「实际未参考」）

# 系统内置本地模型（local 服务商，无需 Key；权重缺失时自动从 ModelScope 下载）：
# LOCAL_EMBED_MODEL=BAAI/bge-m3（向量化，1024 维）
# LOCAL_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B（重排序）
# AI_MODELS_DIR=（权重目录，默认 backend/data/models；生产随 /app/data 卷持久化）
# 预热：python manage.py download_models；切换向量化模型后必须执行重建向量

# ===== RAGAS 评估裁判模型：Kimi（Moonshot，OpenAI 兼容，manage.py eval_rag 使用）=====
# 开放平台 key 用 https://api.moonshot.cn/v1；Kimi for Coding 订阅 key（sk-kimi- 开头）
# 用 https://api.kimi.com/coding/v1，模型填 k3
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
